[Unit]
Description=Transcribe new Plaud recordings and file them in Google Drive
Documentation=file:%h/sec/plaud-scribe/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# `plaud me` (token refresh) needs node on PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Optional: ELEVENLABS_API_KEY=... and ANTHROPIC_API_KEY=... if not kept in config.toml
EnvironmentFile=-%h/.config/plaud-scribe/env
# A wide window so nothing is missed after downtime; [sync] start_date is
# what actually bounds this, and the state db stops any repeat work.
ExecStart=%h/sec/plaud-scribe/.venv/bin/plaud-scribe sync --days 30
Nice=10
TimeoutStartSec=3h

# Hardening: the job needs the network, its own state, and the two token stores.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/plaud-scribe %h/.local/state/plaud-scribe %h/.config/plaud-scribe %h/.plaud
ProtectKernelTunables=true
# ProtectKernelModules is omitted: it drops CAP_SYS_MODULE from the bounding set, which
# an unprivileged user manager cannot do here (exit 218/CAPABILITIES). No loss, since an
# unprivileged process cannot load modules anyway.
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute is deliberately absent: `plaud me` runs node, whose JIT needs it.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
